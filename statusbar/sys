#!/usr/bin/env sh
FREQ="$(awk '/MHz/{ temp+=$4; n++ } END{ printf("%f\n", temp/n) }' /proc/cpuinfo | awk '{ sub(".[^.]*$", ""); print }')"

case $1 in
	"coretemp" )
		TEMP="$(sensors coretemp-isa-0000 | awk '/Pack/{print int($4)}')";;
	"k10temp" )
		TEMP="$(sensors k10temp-pci-00c3 | awk '/Tctl/{print int($2)}')";;
	* ) TEMP="argument is not correct! please set to either coretemp or k10temp depending on your cpu"
esac

LDAVG="$(cat /proc/loadavg | awk '{print ($2)}')"
MEM="$(~/.scripts/statusbar/memoryused)"

	
case $2 in
	"newline" )
		echo -n -e "$FREQ"MHz"\n""$TEMP"°C"\n""$LDAVG""\n""$MEM";;
	"json" )
		export __sys="$FREQ"MHz"\n""$TEMP"°C"\n""$LDAVG""\n""$MEM"
		echo '{"text": "'$__sys'", "tooltip": "uh hi", "class": "sys" }';;
	* )
		echo -n "$FREQ"MHz/"$TEMP"°C/"$LDAVG"/"$MEM"
esac

